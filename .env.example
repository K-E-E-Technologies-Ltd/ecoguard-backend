# Copy to .env and adjust for your environment.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ecoguard:change-me@localhost:5432/ecoguard
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE=ecoguard_session
COOKIE_SECURE=false
SESSION_SAMESITE=lax
SESSION_HOURS=12
JOBS_MODE=inline
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=15
STORAGE_BACKEND=local
MEDIA_DIR=./var/media
MAX_UPLOAD_MB=10
MODEL_VERSION=not-configured
SMS_PROVIDER=disabled
ENABLE_API_DOCS=true
AUTO_CREATE_TABLES=true
DEMO_ENABLED=false